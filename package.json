{
  "name": "portfolio-laboratorios-ciencia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run traceability && next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=reports/vitest.json",
    "traceability": "npm run test:report && tsx scripts/build-traceability.ts",
    "test:e2e": "playwright test",
    "cv:pdf": "tsx scripts/export-cv-pdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@react-pdf/renderer": "^4.9.0",
    "next": "16.3.7",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
